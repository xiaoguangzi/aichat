# Server port (default 3000)
PORT=3000
# Bind address (default 127.0.0.1, loopback only; use 0.0.0.0 to expose on the LAN)
HOST=127.0.0.1
# Data directory for SQLite + uploads (default ./data)
DATA_DIR=./data
# Skills directory (default ./skills)
SKILLS_DIR=./skills
# HTTP request logging: normal (default: writes, errors and slow requests only) | all | off
LOG_HTTP=normal
