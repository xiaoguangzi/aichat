{
  "name": "aichat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"pnpm -C apps/server dev\" \"pnpm -C apps/web dev\"",
    "build": "pnpm -r --filter ./packages/shared --filter ./apps/web --filter ./apps/server build",
    "start": "node --no-warnings=ExperimentalWarning apps/server/dist/index.js",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^5.9.3"
  }
}
